{
  "name": "@bld8/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LUCIDE_LICENSE",
    "DAY_PICKER_LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SHADCN_LICENSE",
    "MOTION_LICENSE",
    "DND_KIT_LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "import": "./dist/react-hook-form.js"
    },
    "./filter-query": {
      "types": "./dist/filter-query.d.ts",
      "import": "./dist/filter-query.js"
    },
    "./kanban-state": {
      "types": "./dist/kanban-state.d.ts",
      "import": "./dist/kanban-state.js"
    },
    "./time-options": {
      "types": "./dist/time-options.d.ts",
      "import": "./dist/time-options.js"
    },
    "./theme-config": {
      "types": "./dist/theme-config.d.ts",
      "import": "./dist/theme-config.js"
    },
    "./chart-state": {
      "types": "./dist/chart-state.d.ts",
      "import": "./dist/chart-state.js"
    },
    "./table-grouping": {
      "types": "./dist/table-grouping.d.ts",
      "import": "./dist/table-grouping.js"
    },
    "./schedule-state": {
      "types": "./dist/schedule-state.d.ts",
      "import": "./dist/schedule-state.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.90.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.7.1",
    "react-day-picker": "10.0.2",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "react-hook-form": "7.90.0",
    "tailwindcss": "4.3.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  }
}
