{
  "name": "@bld8/blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./outline-repository": {
      "types": "./dist/outline-repository.d.ts",
      "import": "./dist/outline-repository.js"
    },
    "./outline-http": {
      "types": "./dist/outline-http.d.ts",
      "import": "./dist/outline-http.js"
    },
    "./issue-repository": {
      "types": "./dist/issue-repository.d.ts",
      "import": "./dist/issue-repository.js"
    },
    "./session-preferences": {
      "types": "./dist/session-preferences.d.ts",
      "import": "./dist/session-preferences.js"
    },
    "./analytics-state": {
      "import": "./dist/analytics-state.js",
      "types": "./dist/analytics-state.d.ts"
    },
    "./issue-data-source": {
      "types": "./dist/issue-data-source.d.ts",
      "import": "./dist/issue-data-source.js"
    },
    "./resource-workspace": {
      "types": "./dist/resource-workspace.d.ts",
      "import": "./dist/resource-workspace.js"
    },
    "./resource-workspace-state": {
      "types": "./dist/resource-workspace-state.d.ts",
      "import": "./dist/resource-workspace-state.js"
    },
    "./resource-data-source": {
      "types": "./dist/resource-data-source.d.ts",
      "import": "./dist/resource-data-source.js"
    },
    "./resource-workspace-view": {
      "types": "./dist/resource-workspace-view.d.ts",
      "import": "./dist/resource-workspace-view.js"
    },
    "./use-resource-workspace": {
      "types": "./dist/use-resource-workspace.d.ts",
      "import": "./dist/use-resource-workspace.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@bld8/ui": "*",
    "lucide-react": "1.55.0",
    "motion": "14.7.1"
  }
}
